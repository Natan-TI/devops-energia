# Copie este arquivo para ".env" e troque os valores. O arquivo .env não vai para o repositório.
# Para gerar um valor aleatório: python -c "import secrets; print(secrets.token_urlsafe(32))"

# Senha do banco de dados (só letras, números, "-" e "_", para caber no endereço de conexão)
POSTGRES_PASSWORD=

# Chave exigida no cabeçalho X-API-Key para gravar eventos e alertas (mínimo de 16 caracteres)
API_KEY=

# Opcional: se preenchido, /metrics só responde com "Authorization: Bearer <valor>"
METRICS_TOKEN=

# Opcional: porta do painel no computador (padrão 8000) e intervalo do simulador em segundos (padrão 5)
PORTA=8000
INTERVALO_S=5

# Senha do usuário "admin" do Grafana (só para docker-compose.observabilidade.yml)
GRAFANA_PASSWORD=

# Opcional: alvo do Prometheus. Padrão: o painel local (api:8000). Para a nuvem: endereço:porta
ALVO=
